# ============================================================
# Agentic Talent Intelligence Platform - Environment Variables
# Copy this file to .env and fill in your actual keys.
# ============================================================

# --- LLM Provider (choose one) ---
OPENAI_API_KEY=sk-your-openai-key-here
GOOGLE_API_KEY=your-google-gemini-key-here

# --- LLM Provider selection: "openai" or "gemini" ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# --- GitHub API ---
# Generate a personal access token at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your-github-pat-here

# --- Feature Flags ---
# Set to True to use mock data instead of live APIs (useful for demos)
USE_MOCK_DATA=False

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_db

# --- App Config ---
APP_PORT=8000
